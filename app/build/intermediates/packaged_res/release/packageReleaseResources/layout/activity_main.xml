<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 顶部标题栏 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="12dp" />

        <!-- 状态卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_bg"
            android:padding="14dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tv_carlife_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="正在检测 CarLife 安装状态..."
                android:textColor="@color/accent_green"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_package_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="目标包名: com.baidu.carlifevehicle"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:paddingTop="4dp" />
        </LinearLayout>

        <!-- 自启动开关与参数设置 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_bg"
            android:padding="14dp"
            android:layout_marginBottom="12dp">

            <CheckBox
                android:id="@+id/cb_autostart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chk_enable_autostart"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:checked="true" />

            <!-- 延时秒数设置 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="12dp">

                <TextView
                    android:id="@+id/tv_delay_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="开机延时启动时间: 30 秒"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

            </LinearLayout>

            <SeekBar
                android:id="@+id/sb_delay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="60"
                android:progress="30"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />

            <!-- 目标包名输入框 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_package_settings"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:paddingTop="8dp" />

            <EditText
                android:id="@+id/et_package_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="com.baidu.carlifevehicle"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:singleLine="true" />

        </LinearLayout>

        <!-- 操作按钮组 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btn_test_launch"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:text="@string/btn_test_launch"
                android:textSize="15sp"
                android:layout_marginRight="8dp" />

            <Button
                android:id="@+id/btn_save"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:text="@string/btn_save"
                android:textSize="15sp"
                android:layout_marginLeft="8dp" />
        </LinearLayout>

        <!-- 车机说明提示 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tips_usage"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"
            android:background="@color/card_bg"
            android:padding="12dp" />

    </LinearLayout>
</ScrollView>
